<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Game_Engine.Views.ProjectPanel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Project" FontSize="14" Margin="8,6" />
    <Border Margin="6" BorderThickness="1" CornerRadius="6" Padding="6">
      <ListBox>
        <ListBoxItem>Assets/Materials/Default.mat</ListBoxItem>
        <ListBoxItem>Assets/Models/Cube.fbx</ListBoxItem>
        <ListBoxItem>Assets/Scripts/Player.cs</ListBoxItem>
      </ListBox>
    </Border>
  </DockPanel>
</UserControl>
