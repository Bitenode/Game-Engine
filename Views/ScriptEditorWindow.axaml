<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Game_Engine.Views.ScriptEditorWindow"
        Width="900" Height="700"
        WindowStartupLocation="CenterOwner"
        Title="Script Editor">
	<DockPanel>
		<!-- Toolbar row ... -->
		<StackPanel Orientation="Horizontal" Spacing="8">
			<Button x:Name="BtnSave"   Content="Save"/>
			<Button x:Name="BtnSaveAs" Content="Save As…"/>
			<Button x:Name="BtnReload" Content="Reload"/>
			<!-- NEW -->
			<Button x:Name="BtnBuild"  Content="Build &amp; Load"/>
			<Button x:Name="BtnClose"  Content="Close"/>
		</StackPanel>

		<!-- status bar at the bottom -->
		<TextBlock x:Name="Status" Margin="8,4,8,0" Opacity=".7"/>

		<TextBox x:Name="Editor"
				 AcceptsReturn="True"
				 AcceptsTab="True"
				 HorizontalAlignment="Stretch"
				 VerticalAlignment="Stretch"
				 FontFamily="Consolas,Menlo,monospace"
				 TextWrapping="NoWrap"/>
	</DockPanel>
</Window>
