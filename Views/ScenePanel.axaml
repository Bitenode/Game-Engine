<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Game_Engine.Views"
             x:Class="Game_Engine.Views.ScenePanel">

	<DockPanel>

		<!-- Top toolbar -->
		<Border DockPanel.Dock="Top"
				Margin="8"
				Padding="8"
				CornerRadius="6"
				Background="#26282B">
			<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

				<TextBlock Text="Tool" Foreground="#DCE0E6" VerticalAlignment="Center"/>

				<!-- Tool mode radios -->
				<RadioButton Content="Hand"   GroupName="tool" Foreground="#DCE0E6"
							 IsChecked="{Binding ElementName=Scene, Path=Tool,
                                         Converter={StaticResource EnumEq},
                                         ConverterParameter=Hand}" />
				<RadioButton Content="Move"   GroupName="tool" Foreground="#DCE0E6"
							 IsChecked="{Binding ElementName=Scene, Path=Tool,
                                         Converter={StaticResource EnumEq},
                                         ConverterParameter=Move}" />
				<RadioButton Content="Rotate" GroupName="tool" Foreground="#DCE0E6"
							 IsChecked="{Binding ElementName=Scene, Path=Tool,
                                         Converter={StaticResource EnumEq},
                                         ConverterParameter=Rotate}" />
				<RadioButton Content="Scale"  GroupName="tool" Foreground="#DCE0E6"
							 IsChecked="{Binding ElementName=Scene, Path=Tool,
                                         Converter={StaticResource EnumEq},
                                         ConverterParameter=Scale}" />

				<!-- AA -->
				<ToggleButton Content="AA ×2"
							  ToolTip.Tip="Supersample render at 2× and downsample (smoother edges)"
							  IsChecked="{Binding ElementName=Scene, Path=Supersample2x, Mode=TwoWay}" />

				<Separator Margin="5,0"/>

				<!-- View toggles -> dropdown with actual CheckBoxes -->
				<Button Content="View ▾" Foreground="#DCE0E6">
					<Button.Flyout>
						<Flyout Placement="Bottom">
							<StackPanel Spacing="6" Margin="10,8">
								<CheckBox Content="Grid"
										  Foreground="#DCE0E6"
										  IsChecked="{Binding ElementName=Scene, Path=ShowGrid, Mode=TwoWay}" />
								<CheckBox Content="Wire"
										  Foreground="#DCE0E6"
										  IsChecked="{Binding ElementName=Scene, Path=ShowWire, Mode=TwoWay}" />
								<CheckBox Content="Gizmos"
										  Foreground="#DCE0E6"
										  IsChecked="{Binding ElementName=Scene, Path=GizmoLocal, Mode=TwoWay}" />
								<CheckBox Content="Light"
										  Foreground="#DCE0E6"
										  IsChecked="{Binding ElementName=Scene, Path=ShowLight, Mode=TwoWay}" />
								<CheckBox Content="2D"
										  Foreground="#DCE0E6"
										  IsChecked="{Binding ElementName=Scene, Path=Is2D, Mode=TwoWay}" />
							</StackPanel>
						</Flyout>
					</Button.Flyout>
				</Button>


				<Separator Margin="5,0"/>

				<!-- FPS counter -->
				<TextBlock Text="{Binding ElementName=Scene, Path=FpsText}"
						   Foreground="#8899AA" FontSize="11"
						   VerticalAlignment="Center" Opacity="0.85"/>

			</StackPanel>
		</Border>

		<!-- Scene viewport -->
		<Border Margin="8"
				BorderThickness="1"
				CornerRadius="6"
				BorderBrush="#3A3D41"
				ClipToBounds="True">
			<views:SceneView x:Name="Scene" Focusable="True"/>
		</Border>

	</DockPanel>
</UserControl>
