<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Game_Engine.Views"
             x:Class="Game_Engine.Views.AnimationPanel">

    <UserControl.Styles>
        <!-- Transport buttons -->
        <Style Selector="Button.transport">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="Button.transport:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
        <!-- Record toggle -->
        <Style Selector="ToggleButton.record">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="ToggleButton.record:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.record:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B91C1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Action buttons (+ New, + Add Property, + Add Animator) -->
        <Style Selector="Button.action">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <!-- Key button (diamond icon, for adding keyframes) -->
        <Style Selector="Button.keyBtn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="Foreground" Value="#D97706"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.keyBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D97706"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Remove button (x) -->
        <Style Selector="Button.remove">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Button.remove:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Inline value TextBox -->
        <Style Selector="TextBox.trackValue">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="MaxWidth" Value="60"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.trackValue:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
        </Style>
        <!-- Transform section value TextBox (slightly wider) -->
        <Style Selector="TextBox.transformValue">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="MaxWidth" Value="65"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.transformValue:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
        </Style>
        <!-- Bone tree item -->
        <Style Selector="Button.boneItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style Selector="Button.boneItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
        <Style Selector="Button.boneItemSelected">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="20"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Header + GameObject Selector Row -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <Grid ColumnDefinitions="Auto,12,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Animation" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="GameObject:"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CbGameObject" Grid.Column="3" MinWidth="140" MaxWidth="300"
                          Height="26" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                <Button x:Name="BtnAddAnimator" Grid.Column="4" Classes="action"
                        Content="+ Add Animator"
                        Height="26" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                        IsVisible="False"/>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                Margin="0,0,0,6">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,12,Auto,Auto,12,Auto,*,Auto">

                <!-- Transport — clear text labels -->
                <Button x:Name="BtnPlay" Grid.Column="0" Classes="transport" Margin="0,0,3,0"
                        ToolTip.Tip="Play" Height="26" Padding="8,0" FontSize="11">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="▶" FontSize="12" Foreground="#2E9E47" VerticalAlignment="Center"/>
                        <TextBlock Text="Play" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnPause" Grid.Column="1" Classes="transport" Margin="0,0,3,0"
                        ToolTip.Tip="Pause" Height="26" Padding="8,0" FontSize="11">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="❚❚" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="Pause" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnStop" Grid.Column="2" Classes="transport" Margin="0,0,3,0"
                        ToolTip.Tip="Stop" Height="26" Padding="8,0" FontSize="11">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="■" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Stop" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Record -->
                <ToggleButton x:Name="BtnRecord" Grid.Column="3" Classes="record" Margin="0"
                              ToolTip.Tip="Record (auto-key)" Height="26" Padding="8,0" FontSize="11">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="●" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Rec" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <!-- View mode -->
                <RadioButton x:Name="RbTimeline" Grid.Column="5" Content="Timeline" GroupName="viewMode"
                             IsChecked="True"
                             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                             FontSize="11" VerticalAlignment="Center"/>
                <RadioButton x:Name="RbCurves" Grid.Column="6" Content="Curves" GroupName="viewMode"
                             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                             FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>

                <!-- State machine toggle -->
                <RadioButton x:Name="RbStateMachine" Grid.Column="8" Content="State Machine" GroupName="viewMode"
                             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                             FontSize="11" VerticalAlignment="Center"/>

                <!-- Time display + clip selector -->
                <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTime" Text="0:00.000"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="11" VerticalAlignment="Center" MinWidth="55"/>
                    <ComboBox x:Name="CbClip" MinWidth="100" MaxWidth="200" Height="26" FontSize="11"
                              VerticalAlignment="Center"/>
                    <Button x:Name="BtnNewClip" Classes="action" Content="+ New" Height="26" FontSize="11"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content area: switches between timeline, curves, and state machine -->
        <Grid>
            <!-- Timeline / Curves views share the split layout -->
            <Grid x:Name="TimelineCurveGrid" ColumnDefinitions="270,4,*">

                <!-- Left: Transform editor + Track list -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="6,0,0,6">
                    <DockPanel>
                        <Button x:Name="BtnAddTrack" DockPanel.Dock="Bottom" Classes="action"
                                Content="+ Add Property"
                                Margin="4" Height="26" FontSize="11"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="0" Margin="2">
                                <!-- Transform Editor Section (always visible when GO selected) -->
                                <StackPanel x:Name="TransformSection" Spacing="0" IsVisible="False"/>

                                <!-- Separator between transform and tracks -->
                                <Border x:Name="TransformTrackSeparator" IsVisible="False"
                                        Height="1"
                                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        Margin="4,4"/>

                                <!-- Bone Tree Section (visible when GO has SkinnedMeshRenderer) -->
                                <StackPanel x:Name="BoneTreeSection" Spacing="0" IsVisible="False"/>

                                <!-- Separator between bones and tracks -->
                                <Border x:Name="BoneTrackSeparator" IsVisible="False"
                                        Height="1"
                                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        Margin="4,4"/>

                                <!-- Existing dynamic tracks -->
                                <StackPanel x:Name="TrackListPanel" Spacing="0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="4" Background="Transparent"/>

                <!-- Right: Canvas area (timeline or curves drawn here) -->
                <Border Grid.Column="2"
                        Background="#1A1B1E"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,6,6"
                        ClipToBounds="True">
                    <local:AnimationCanvas x:Name="Canvas"/>
                </Border>
            </Grid>

            <!-- State machine view (hidden by default) -->
            <Border x:Name="StateMachineGrid" IsVisible="False"
                    Background="#1A1B1E"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="6,0,6,6"
                    ClipToBounds="True">
                <local:StateMachineCanvas x:Name="SmCanvas"/>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
