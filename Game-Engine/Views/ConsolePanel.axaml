<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Game_Engine.Views"
             x:Class="Game_Engine.Views.ConsolePanel">
	<UserControl.Resources>
		<local:SeverityToBrushConverter x:Key="SeverityBg"     Kind="Background"/>
		<local:SeverityToBrushConverter x:Key="SeverityBorder" Kind="Border"/>
		<local:SeverityToBrushConverter x:Key="SeverityText"   Kind="Text"/>
	</UserControl.Resources>

	<DockPanel>
		<TextBlock DockPanel.Dock="Top" Text="Console" FontSize="14" Margin="8,6" />

		<!-- Filters -->
		<Border DockPanel.Dock="Top" Margin="6,0,6,4" Padding="6" CornerRadius="4" Background="#2A2C30">
			<StackPanel Spacing="4">
				<WrapPanel Orientation="Horizontal">
					<Button x:Name="BtnClear" Content="Clear" Margin="0,0,6,0" Padding="8,2" FontSize="11"/>
					<Button x:Name="BtnCopy" Content="Copy Selected" Margin="0,0,6,0" Padding="8,2" FontSize="11"/>
					<ToggleButton x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True" Padding="8,2" FontSize="11"/>
				</WrapPanel>
				<TextBox x:Name="FilterText"
						 Watermark="Search messages…"
						 FontSize="11" />
				<WrapPanel Orientation="Horizontal">
					<ToggleButton x:Name="ChkInfo" Content="Info" IsChecked="True" Margin="0,0,6,0" Padding="8,2" FontSize="11"/>
					<ToggleButton x:Name="ChkWarn" Content="Warn" IsChecked="True" Margin="0,0,6,0" Padding="8,2" FontSize="11"/>
					<ToggleButton x:Name="ChkError" Content="Error" IsChecked="True" Margin="0,0,6,0" Padding="8,2" FontSize="11"/>
					<ToggleButton x:Name="ChkSuccess" Content="OK" IsChecked="True" Margin="0,0,6,0" Padding="8,2" FontSize="11"/>
					<ToggleButton x:Name="ChkDebug" Content="Debug" IsChecked="True" Padding="8,2" FontSize="11"/>
				</WrapPanel>
			</StackPanel>
		</Border>

		<Grid Margin="6" RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
			<ListBox x:Name="List"
					 Grid.Row="0" Grid.ColumnSpan="2"
					 ItemsSource="{Binding VisibleLogs}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
							<TextBlock Grid.Column="0"
									   Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
									   Margin="0,0,8,0"
									   Opacity="0.7"/>
							<Border Grid.Column="1" Padding="6,1" CornerRadius="10"
									Margin="0,0,8,0"
									Background="{Binding Severity, Converter={StaticResource SeverityBg}}"
									BorderBrush="{Binding Severity, Converter={StaticResource SeverityBorder}}"
									BorderThickness="1">
								<TextBlock Text="{Binding Severity}"
										   FontWeight="Bold"
										   Foreground="White"/>
							</Border>
							<TextBlock Grid.Column="2"
									   Text="{Binding Message}"
									   TextWrapping="Wrap"
									   Foreground="{Binding Severity, Converter={StaticResource SeverityText}}"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<TextBox x:Name="Input"
					 Grid.Row="1" Grid.Column="0"
					 Watermark="> enter command..." />

			<Button x:Name="RunButton"
					Grid.Row="1" Grid.Column="1"
					Content="Run" Margin="6,0,0,0" />
		</Grid>
	</DockPanel>
</UserControl>
