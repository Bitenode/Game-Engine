<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Game_Engine.Core"
             xmlns:views="clr-namespace:Game_Engine.Views"
             x:Class="Game_Engine.Views.HierarchyPanel"
             x:CompileBindings="False">

	<!-- Shared menu and converters used by BOTH the Tree root and each TreeViewItem -->
	<UserControl.Resources>
		<views:PrefabColorConverter x:Key="PrefabColor"/>
		<views:HierarchyForegroundConverter x:Key="HierarchyForeground"/>
		<views:HierarchyTypeIconConverter x:Key="HierarchyTypeIcon"/>

		<ContextMenu x:Key="HierarchyMenu">
			<MenuItem Header="Create">
				<MenuItem Header="Empty Child"  Click="OnCreateChild"/>
				<MenuItem Header="Cube"         Click="OnCreateCube"/>
				<MenuItem Header="Cone"         Click="OnCreateCone"/>
				<MenuItem Header="Cylinder"     Click="OnCreateCylinder"/>
				<Separator/>
				<MenuItem Header="Import Model" Click="OnImportModel"/>
			</MenuItem>
			<MenuItem Header="Prefab">
				<MenuItem Header="Create Prefab"      Click="OnCreatePrefab"/>
				<MenuItem Header="Instantiate Prefab" Click="OnInstantiatePrefab"/>
				<Separator/>
				<MenuItem Header="Apply to Prefab"    Click="OnApplyToPrefab"/>
				<MenuItem Header="Revert to Prefab"   Click="OnRevertToPrefab"/>
				<MenuItem Header="Unpack Prefab"      Click="OnUnpackPrefab"/>
			</MenuItem>
			<Separator/>
			<MenuItem Header="Unparent"          Click="OnUnparent"/>
			<MenuItem Header="Duplicate"         Click="OnDuplicate"        InputGesture="Ctrl+D"/>
			<MenuItem Header="Rename"            Click="OnRename"           InputGesture="F2"/>
			<MenuItem Header="Delete"            Click="OnDelete"           InputGesture="Delete"/>
			<Separator/>
			<MenuItem Header="Expand All"        Click="OnExpandAll"/>
			<MenuItem Header="Collapse All"      Click="OnCollapseAll"/>
			<Separator/>
			<MenuItem Header="Reveal in Project" Click="OnRevealInProject"  InputGesture="Ctrl+Shift+R"/>
		</ContextMenu>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- Compact icon toolbar buttons -->
		<Style Selector="Button.hier-tool-btn">
			<Setter Property="Width" Value="26"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
		</Style>
		<Style Selector="Button.hier-tool-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
		</Style>
		<Style Selector="Button.hier-tool-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
		</Style>
		<Style Selector="Button.hier-tool-btn.active /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
		</Style>

		<!-- Tiny inline buttons inside search pill -->
		<Style Selector="Button.hier-inline-btn">
			<Setter Property="Width" Value="20"/>
			<Setter Property="Height" Value="20"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
		</Style>
		<Style Selector="Button.hier-inline-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
		</Style>
		<Style Selector="Button.hier-inline-btn.active /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
		</Style>

		<!-- Search pill surface -->
		<Style Selector="Border.hier-search-pill">
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="6,1,3,1"/>
		</Style>
		<Style Selector="Border.hier-search-pill:focus-within">
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
		</Style>

		<!-- Borderless TextBox inside search pill -->
		<Style Selector="TextBox.hier-search-input">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="MinHeight" Value="22"/>
			<Setter Property="Padding" Value="4,3"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBox.hier-search-input:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="TextBox.hier-search-input:focus /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<!-- Default theme-aware stroke for type icons (overridden by HierarchyForeground for prefabs/disabled) -->
		<Style Selector="Path.hier-type-icon">
			<Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
		</Style>

		<!-- Tree frame (matches editor-panel treatment in MainWindow) -->
		<Style Selector="Border#TreeHostBorder">
			<Setter Property="Background" Value="{DynamicResource SystemControlPageBackgroundAltHighBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="ClipToBounds" Value="True"/>
		</Style>
		<Style Selector="Border#TreeHostBorder.drop-target-root">
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
			<Setter Property="BorderThickness" Value="1.5"/>
		</Style>
	</UserControl.Styles>

	<DockPanel>
		<!-- Compact toolbar header (no duplicate title; dock tab provides "Hierarchy") -->
		<Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="6,4,6,4">
			<!-- Left: Create (+) button with Create flyout -->
			<Button x:Name="BtnCreate"
					Grid.Column="0"
					Classes="hier-tool-btn"
					ToolTip.Tip="Create GameObject…">
				<Button.Flyout>
					<MenuFlyout Opening="OnCreateFlyoutOpening">
						<MenuItem Header="Empty Child"  Click="OnCreateChild"/>
						<MenuItem Header="Cube"         Click="OnCreateCube"/>
						<MenuItem Header="Cone"         Click="OnCreateCone"/>
						<MenuItem Header="Cylinder"     Click="OnCreateCylinder"/>
						<Separator/>
						<MenuItem Header="Import Model" Click="OnImportModel"/>
					</MenuFlyout>
				</Button.Flyout>
				<Viewbox Width="13" Height="13">
					<Canvas Width="24" Height="24">
						<Path Data="M12,5 L12,19 M5,12 L19,12"
							  Stroke="{Binding $parent[Button].Foreground}"
							  StrokeThickness="2.2"
							  StrokeLineCap="Round"/>
					</Canvas>
				</Viewbox>
			</Button>

			<!-- Right: Expand All, Collapse All, Filter toggle -->
			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
				<Button x:Name="BtnExpandAll"
						Classes="hier-tool-btn"
						ToolTip.Tip="Expand All"
						Click="OnExpandAll">
					<Viewbox Width="13" Height="13">
						<Canvas Width="24" Height="24">
							<Path Data="M6,9 L12,4 L18,9 M6,15 L12,20 L18,15"
								  Stroke="{Binding $parent[Button].Foreground}"
								  StrokeThickness="2"
								  StrokeLineCap="Round"
								  StrokeJoin="Round"/>
						</Canvas>
					</Viewbox>
				</Button>

				<Button x:Name="BtnCollapseAll"
						Classes="hier-tool-btn"
						ToolTip.Tip="Collapse All"
						Click="OnCollapseAll">
					<Viewbox Width="13" Height="13">
						<Canvas Width="24" Height="24">
							<Path Data="M6,5 L12,10 L18,5 M6,19 L12,14 L18,19"
								  Stroke="{Binding $parent[Button].Foreground}"
								  StrokeThickness="2"
								  StrokeLineCap="Round"
								  StrokeJoin="Round"/>
						</Canvas>
					</Viewbox>
				</Button>

				<Border Width="1"
						Height="14"
						Margin="3,0"
						Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
						VerticalAlignment="Center"/>

				<Button x:Name="BtnToggleFilters"
						Classes="hier-tool-btn"
						ToolTip.Tip="Hide or show hierarchy search filters"
						Click="OnToggleFiltersStripClick">
					<Grid Width="15" Height="15">
						<Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
							<Canvas Width="24" Height="24">
								<Path x:Name="ToggleFilterRing"
									  Data="M3,5 L21,5 L14,13 L14,20 L10,18 L10,13 Z"
									  StrokeThickness="1.9"
									  StrokeLineCap="Round"
									  StrokeJoin="Round"
									  Fill="Transparent"/>
							</Canvas>
						</Viewbox>
						<Ellipse x:Name="ToggleFilterDot"
								 Width="5"
								 Height="5"
								 HorizontalAlignment="Right"
								 VerticalAlignment="Top"
								 IsVisible="False"/>
					</Grid>
				</Button>
			</StackPanel>
		</Grid>

		<!-- Search pill filter strip -->
		<StackPanel x:Name="FilterRoot" DockPanel.Dock="Top" Spacing="4" Margin="6,0,6,4">
			<Border Classes="hier-search-pill">
				<Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
					<!-- Leading search glyph -->
					<Viewbox Grid.Column="0" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center">
						<Canvas Width="24" Height="24">
							<Path Data="M10.5,4 A6.5,6.5 0 1,0 10.5,17 A6.5,6.5 0 1,0 10.5,4 M15.5,15.5 L20.5,20.5"
								  Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"
								  StrokeThickness="2.2"
								  StrokeLineCap="Round"/>
						</Canvas>
					</Viewbox>

					<!-- Name filter input -->
					<TextBox x:Name="FilterName"
							 Grid.Column="1"
							 Classes="hier-search-input"
							 PlaceholderText="Search objects… (Ctrl+F)"/>

					<!-- Clear button -->
					<Button x:Name="BtnClearFilter"
							Grid.Column="2"
							Classes="hier-inline-btn"
							IsVisible="False"
							ToolTip.Tip="Clear search filter"
							Click="OnClearFilterClick">
						<Viewbox Width="10" Height="10">
							<Canvas Width="24" Height="24">
								<Path Data="M6,6 L18,18 M18,6 L6,18"
									  Stroke="{Binding $parent[Button].Foreground}"
									  StrokeThickness="2.4"
									  StrokeLineCap="Round"/>
							</Canvas>
						</Viewbox>
					</Button>

					<!-- Toggle component filter field -->
					<Button x:Name="BtnToggleComponentFilter"
							Grid.Column="3"
							Classes="hier-inline-btn"
							Margin="2,0,0,0"
							ToolTip.Tip="Filter by component type"
							Click="OnToggleComponentFilterClick">
						<Viewbox Width="12" Height="12">
							<Canvas Width="24" Height="24">
								<Path Data="M8,6 L3,12 L8,18 M16,6 L21,12 L16,18 M14,4 L10,20"
									  Stroke="{Binding $parent[Button].Foreground}"
									  StrokeThickness="2"
									  StrokeLineCap="Round"
									  StrokeJoin="Round"/>
							</Canvas>
						</Viewbox>
					</Button>
				</Grid>
			</Border>

			<!-- Secondary component filter row (collapsed by default, toggled via button) -->
			<Border x:Name="FilterComponentRow"
					Classes="hier-search-pill"
					IsVisible="False">
				<Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
					<TextBlock Grid.Column="0"
							   Text="Comp:"
							   FontSize="11"
							   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
							   VerticalAlignment="Center"
							   Margin="0,0,4,0"/>
					<TextBox x:Name="FilterComponent"
							 Grid.Column="1"
							 Classes="hier-search-input"
							 PlaceholderText="Component type contains…"/>
				</Grid>
			</Border>
		</StackPanel>

		<!-- Main tree surface + dropdown match overlay + empty state -->
		<Grid Margin="6,2,6,6">
			<Border x:Name="TreeHostBorder" Padding="4">
				<Grid>
					<TreeView x:Name="Tree"
							  SelectionMode="Multiple"
							  ItemsSource="{Binding Root}"
							  ContextMenu="{StaticResource HierarchyMenu}">
						<TreeView.Styles>
							<Style Selector="TreeViewItem">
								<Setter Property="IsExpanded" Value="True"/>
								<Setter Property="ContextMenu" Value="{StaticResource HierarchyMenu}"/>
								<Setter Property="MinHeight" Value="24"/>
								<Setter Property="Padding" Value="4,1"/>
								<Setter Property="Margin" Value="0,1"/>
								<Setter Property="FontSize" Value="12.5"/>
							</Style>
							<Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
								<Setter Property="CornerRadius" Value="4"/>
								<Setter Property="BorderThickness" Value="1"/>
								<Setter Property="BorderBrush" Value="Transparent"/>
							</Style>
							<Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
								<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
							</Style>
							<Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
								<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
							</Style>
							<Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
								<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentMediumBrush}"/>
							</Style>
							<Style Selector="TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
								<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentMediumBrush}"/>
							</Style>
							<Style Selector="TreeViewItem.drop-target /template/ Border#PART_LayoutRoot">
								<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
								<Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
								<Setter Property="BorderThickness" Value="1.5"/>
							</Style>
						</TreeView.Styles>

						<TreeView.DataTemplates>
							<TreeDataTemplate DataType="core:GameObject"
											  ItemsSource="{Binding HierarchyChildren}">
								<Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,1">
									<!-- Type glyph -->
									<Viewbox Grid.Column="0"
											 Width="14"
											 Height="14"
											 Margin="0,0,6,0"
											 VerticalAlignment="Center">
										<Canvas Width="24" Height="24">
											<Path Classes="hier-type-icon"
												  StrokeThickness="1.8"
												  StrokeLineCap="Round"
												  StrokeJoin="Round"
												  Fill="Transparent">
												<Path.Data>
													<MultiBinding Converter="{StaticResource HierarchyTypeIcon}">
														<Binding/>
														<Binding Path="Behaviors.Count"/>
														<Binding Path="PrefabId"/>
													</MultiBinding>
												</Path.Data>
												<Path.Stroke>
													<MultiBinding Converter="{StaticResource HierarchyForeground}">
														<Binding Path="PrefabId"/>
														<Binding Path="IsActiveInHierarchy"/>
													</MultiBinding>
												</Path.Stroke>
											</Path>
										</Canvas>
									</Viewbox>

									<!-- Name -->
									<TextBlock Grid.Column="1"
											   Text="{Binding Name}"
											   TextTrimming="CharacterEllipsis"
											   VerticalAlignment="Center">
										<TextBlock.Foreground>
											<MultiBinding Converter="{StaticResource HierarchyForeground}">
												<Binding Path="PrefabId"/>
												<Binding Path="IsActiveInHierarchy"/>
											</MultiBinding>
										</TextBlock.Foreground>
									</TextBlock>

									<!-- Prefab badge -->
									<Border Grid.Column="2"
											IsVisible="{Binding PrefabId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
											CornerRadius="3"
											Padding="4,0"
											Margin="6,0,2,0"
											VerticalAlignment="Center"
											BorderThickness="1"
											BorderBrush="{Binding PrefabId, Converter={StaticResource PrefabColor}}"
											Opacity="0.85">
										<TextBlock Text="P"
												   FontSize="9.5"
												   FontWeight="SemiBold"
												   Foreground="{Binding PrefabId, Converter={StaticResource PrefabColor}}"
												   VerticalAlignment="Center"/>
									</Border>
								</Grid>
							</TreeDataTemplate>
						</TreeView.DataTemplates>
					</TreeView>

					<!-- Empty-state hint (hit-test transparent so right-click opens context menu) -->
					<StackPanel x:Name="EmptyStateOverlay"
								IsVisible="False"
								IsHitTestVisible="False"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Spacing="8"
								Margin="16">
						<Viewbox Width="28" Height="28" HorizontalAlignment="Center" Opacity="0.45">
							<Canvas Width="24" Height="24">
								<Path Data="M12,3 L20,7.5 L20,16.5 L12,21 L4,16.5 L4,7.5 Z M12,12 L20,7.5 M12,12 L4,7.5 M12,12 L12,21"
									  Stroke="{DynamicResource SystemControlForegroundBaseMediumBrush}"
									  StrokeThickness="1.6"
									  StrokeLineCap="Round"
									  StrokeJoin="Round"/>
							</Canvas>
						</Viewbox>
						<TextBlock Text="No objects in scene.&#x0a;Right-click or press + to create one."
								   TextAlignment="Center"
								   TextWrapping="Wrap"
								   FontSize="12"
								   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
					</StackPanel>
				</Grid>
			</Border>

			<!-- Floating dropdown-like match list overlay below search strip -->
			<Border x:Name="MatchListOverlay"
					ZIndex="20"
					IsVisible="False"
					VerticalAlignment="Top"
					Margin="2,2,2,8"
					CornerRadius="6"
					BorderThickness="1"
					BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
					Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
					BoxShadow="0 6 18 0 #40000000"
					Padding="4">
				<ListBox x:Name="MatchList"
						 MinHeight="40"
						 MaxHeight="220"
						 IsVisible="False"
						 SelectionMode="Single"
						 Background="Transparent"/>
			</Border>
		</Grid>
	</DockPanel>
</UserControl>
