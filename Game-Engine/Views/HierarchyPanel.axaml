<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Game_Engine.Core"
             xmlns:views="clr-namespace:Game_Engine.Views"
             x:Class="Game_Engine.Views.HierarchyPanel">

	<!-- Shared menu used by BOTH the Tree root and each TreeViewItem -->
	<UserControl.Resources>
		<views:PrefabColorConverter x:Key="PrefabColor"/>
		<views:HierarchyForegroundConverter x:Key="HierarchyForeground"/>

		<ContextMenu x:Key="HierarchyMenu">
			<MenuItem Header="Create Empty Child" Click="OnCreateChild"/>
			<MenuItem Header="Create Cube"        Click="OnCreateCube"/>
			<MenuItem Header="Create Cone"        Click="OnCreateCone"/>
			<MenuItem Header="Create Cylinder"    Click="OnCreateCylinder"/>
			<MenuItem Header="Import Model"       Click="OnImportModel"/>
			<Separator/>
			<MenuItem Header="Create Prefab"       Click="OnCreatePrefab"/>
			<MenuItem Header="Instantiate Prefab"  Click="OnInstantiatePrefab"/>
			<MenuItem Header="Apply to Prefab"     Click="OnApplyToPrefab"/>
			<MenuItem Header="Revert to Prefab"    Click="OnRevertToPrefab"/>
			<MenuItem Header="Unpack Prefab"       Click="OnUnpackPrefab"/>
			<Separator/>
			<MenuItem Header="Unparent"           Click="OnUnparent"/>
			<MenuItem Header="Delete"             Click="OnDelete"/>
			<Separator/>
			<MenuItem Header="Expand All"         Click="OnExpandAll"/>
			<MenuItem Header="Collapse All"       Click="OnCollapseAll"/>
		</ContextMenu>
	</UserControl.Resources>

	<DockPanel>
		<TextBlock DockPanel.Dock="Top" Text="Hierarchy" FontSize="14" Margin="8,6" />

		<Border Margin="6" BorderThickness="1" CornerRadius="6" Padding="6">
			<TreeView x:Name="Tree"
					  SelectionMode="Multiple"
					  ItemsSource="{Binding Root}"
					  ContextMenu="{StaticResource HierarchyMenu}">
				<TreeView.Styles>
					<Style Selector="TreeViewItem">
						<Setter Property="IsExpanded" Value="True"/>
						<Setter Property="ContextMenu" Value="{StaticResource HierarchyMenu}"/>
					</Style>
				</TreeView.Styles>

				<TreeView.DataTemplates>
					<TreeDataTemplate DataType="core:GameObject"
									  ItemsSource="{Binding Children}">
						<TextBlock Text="{Binding Name}">
							<TextBlock.Foreground>
								<MultiBinding Converter="{StaticResource HierarchyForeground}">
									<Binding Path="PrefabId"/>
									<Binding Path="IsActiveInHierarchy"/>
								</MultiBinding>
							</TextBlock.Foreground>
						</TextBlock>
					</TreeDataTemplate>
				</TreeView.DataTemplates>
			</TreeView>
		</Border>
	</DockPanel>
</UserControl>
