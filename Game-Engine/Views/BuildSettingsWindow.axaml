<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Game_Engine.Views.BuildSettingsWindow"
        Title="Build Settings"
        Width="580" Height="660"
        CanResize="True"
        MinWidth="480" MinHeight="520">

  <Window.Styles>
    <!-- Section card -->
    <Style Selector="Border.section">
      <Setter Property="Background"      Value="#22252A"/>
      <Setter Property="CornerRadius"    Value="8"/>
      <Setter Property="Padding"         Value="14,10"/>
      <Setter Property="Margin"          Value="0,0,0,10"/>
      <Setter Property="BorderBrush"     Value="#2E3238"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Section header text -->
    <Style Selector="TextBlock.section-header">
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Foreground"      Value="#C8CDD4"/>
      <Setter Property="Margin"          Value="0,0,0,8"/>
    </Style>

    <!-- Form label -->
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Foreground"      Value="#8B929A"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Width"           Value="120"/>
    </Style>

    <!-- Form row -->
    <Style Selector="StackPanel.form-row">
      <Setter Property="Orientation"     Value="Horizontal"/>
      <Setter Property="Spacing"         Value="8"/>
      <Setter Property="Margin"          Value="0,3"/>
    </Style>

    <!-- Primary action button -->
    <Style Selector="Button.primary">
      <Setter Property="Background"      Value="#3478F6"/>
      <Setter Property="Foreground"      Value="White"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Padding"         Value="18,8"/>
      <Setter Property="CornerRadius"    Value="6"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background"      Value="#4A8AF7"/>
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Background"      Value="#2A6AE0"/>
    </Style>

    <!-- Secondary action button -->
    <Style Selector="Button.secondary">
      <Setter Property="Background"      Value="#2B2F33"/>
      <Setter Property="Foreground"      Value="#C8CDD4"/>
      <Setter Property="Padding"         Value="18,8"/>
      <Setter Property="CornerRadius"    Value="6"/>
      <Setter Property="BorderBrush"     Value="#3A3D41"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background"      Value="#33383D"/>
    </Style>
    <Style Selector="Button.secondary:pressed">
      <Setter Property="Background"      Value="#3B4147"/>
    </Style>

    <!-- Expander tweaks -->
    <Style Selector="Expander">
      <Setter Property="Margin"          Value="0,0,0,10"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Foreground"      Value="#C8CDD4"/>
    </Style>

    <!-- Progress bar -->
    <Style Selector="ProgressBar.build-progress">
      <Setter Property="Height"          Value="6"/>
      <Setter Property="CornerRadius"    Value="3"/>
      <Setter Property="Foreground"      Value="#33C759"/>
      <Setter Property="Background"      Value="#1E2024"/>
      <Setter Property="Margin"          Value="0,6,0,0"/>
    </Style>

    <!-- Status text -->
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Foreground"      Value="#6B7280"/>
      <Setter Property="Margin"          Value="0,4,0,0"/>
    </Style>

    <!-- Scene list items -->
    <Style Selector="ListBox.scene-list">
      <Setter Property="Background"      Value="#1A1D21"/>
      <Setter Property="BorderBrush"     Value="#2E3238"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="6"/>
      <Setter Property="MinHeight"       Value="90"/>
      <Setter Property="MaxHeight"       Value="180"/>
    </Style>
    <Style Selector="ListBox.scene-list ListBoxItem">
      <Setter Property="Padding"         Value="8,5"/>
      <Setter Property="FontSize"        Value="12"/>
    </Style>
    <Style Selector="ListBox.scene-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background"      Value="#2A3A50"/>
    </Style>

    <!-- Small icon-style button for scene list toolbar -->
    <Style Selector="Button.scene-btn">
      <Setter Property="Background"      Value="#2B2F33"/>
      <Setter Property="Foreground"      Value="#C8CDD4"/>
      <Setter Property="Padding"         Value="8,5"/>
      <Setter Property="CornerRadius"    Value="5"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="MinWidth"        Value="28"/>
      <Setter Property="BorderBrush"     Value="#3A3D41"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.scene-btn:pointerover">
      <Setter Property="Background"      Value="#33383D"/>
    </Style>
    <Style Selector="Button.scene-btn:pressed">
      <Setter Property="Background"      Value="#3B4147"/>
    </Style>
    <Style Selector="Button.scene-btn:disabled">
      <Setter Property="Opacity"         Value="0.4"/>
    </Style>

    <!-- Startup badge -->
    <Style Selector="TextBlock.startup-badge">
      <Setter Property="FontSize"        Value="10"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="Foreground"      Value="#33C759"/>
      <Setter Property="Margin"          Value="6,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">

    <!-- ─── Title ─── -->
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
      <TextBlock Text="Build Settings" FontSize="20" FontWeight="Bold" Foreground="#E4E8EE"/>
      <TextBlock Text="Configure and build your project for the target platform."
                 FontSize="12" Foreground="#6B7280"/>
    </StackPanel>

    <!-- ─── Scrollable body ─── -->
    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="0">

        <!-- ── Platform & Config ── -->
        <Border Classes="section">
          <StackPanel Spacing="2">
            <TextBlock Classes="section-header" Text="Target"/>

            <StackPanel Classes="form-row">
              <TextBlock Classes="label" Text="Platform"/>
              <ComboBox x:Name="PlatformBox" Width="200"
                        SelectedIndex="0">
                <ComboBoxItem Content="Windows"/>
                <ComboBoxItem Content="Linux"/>
                <ComboBoxItem Content="macOS"/>
              </ComboBox>
            </StackPanel>

            <StackPanel Classes="form-row">
              <TextBlock Classes="label" Text="Architecture"/>
              <StackPanel Orientation="Horizontal" Spacing="14">
                <RadioButton x:Name="ArchX64"   Content="x64"   GroupName="Arch" IsChecked="True"/>
                <RadioButton x:Name="ArchArm64" Content="ARM64" GroupName="Arch"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Classes="form-row">
              <TextBlock Classes="label" Text="Configuration"/>
              <StackPanel Orientation="Horizontal" Spacing="14">
                <RadioButton x:Name="CfgDebug"   Content="Debug"   GroupName="Cfg"/>
                <RadioButton x:Name="CfgRelease" Content="Release" GroupName="Cfg" IsChecked="True"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ── Scenes In Build ── -->
        <Border Classes="section">
          <StackPanel Spacing="4">
            <TextBlock Classes="section-header" Text="Scenes In Build"/>
            <TextBlock Text="The first scene is loaded on startup. Drag or use arrows to reorder."
                       FontSize="11" Foreground="#6B7280" Margin="0,0,0,6"/>

            <ListBox x:Name="SceneList" Classes="scene-list"
                     SelectionMode="Single"/>

            <!-- Scene toolbar -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
              <Button x:Name="BtnAddScene"     Classes="scene-btn" Content="+ Add Scene"
                      ToolTip.Tip="Add a scene from the project"/>
              <Button x:Name="BtnRemoveScene"  Classes="scene-btn" Content="Remove"
                      ToolTip.Tip="Remove selected scene from build"/>
              <Separator Margin="4,0"/>
              <Button x:Name="BtnSceneUp"      Classes="scene-btn" Content="▲"
                      ToolTip.Tip="Move up (earlier in load order)"/>
              <Button x:Name="BtnSceneDown"    Classes="scene-btn" Content="▼"
                      ToolTip.Tip="Move down (later in load order)"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ── Player Settings ── -->
        <Expander Header="Player Settings" IsExpanded="True">
          <Border Classes="section">
            <StackPanel Spacing="2">
              <StackPanel Classes="form-row">
                <TextBlock Classes="label" Text="Product Name"/>
                <TextBox x:Name="ProductNameBox" Width="260" Watermark="My Game"/>
              </StackPanel>
              <StackPanel Classes="form-row">
                <TextBlock Classes="label" Text="Company"/>
                <TextBox x:Name="CompanyBox" Width="260" Watermark="Studio"/>
              </StackPanel>
              <StackPanel Classes="form-row">
                <TextBlock Classes="label" Text="Version"/>
                <TextBox x:Name="VersionBox" Width="140" Text="1.0.0" Watermark="1.0.0"/>
              </StackPanel>
              <StackPanel Classes="form-row">
                <TextBlock Classes="label" Text="Rendering"/>
                <CheckBox x:Name="DeferredRenderingCheck" Content="Deferred shading in Game View (play mode)"
                          ToolTip.Tip="When off, Game View uses forward rendering. Scene View stays forward for editor performance."/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Expander>

        <!-- ── Resolution ── -->
        <Expander Header="Resolution" IsExpanded="True">
          <Border Classes="section">
            <StackPanel Spacing="2">
              <StackPanel Classes="form-row">
                <TextBlock Classes="label" Text="Width"/>
                <NumericUpDown x:Name="ResWidth" Width="130"
                               Value="1920" Minimum="320" Maximum="7680"
                               Increment="1" FormatString="F0"/>
              </StackPanel>
              <StackPanel Classes="form-row">
                <TextBlock Classes="label" Text="Height"/>
                <NumericUpDown x:Name="ResHeight" Width="130"
                               Value="1080" Minimum="240" Maximum="4320"
                               Increment="1" FormatString="F0"/>
              </StackPanel>
              <StackPanel Classes="form-row">
                <TextBlock Classes="label" Text="Fullscreen"/>
                <CheckBox x:Name="FullscreenCheck" Content="Launch fullscreen"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Expander>

        <!-- ── Output ── -->
        <Expander Header="Output" IsExpanded="True">
          <Border Classes="section">
            <StackPanel Spacing="2">
              <StackPanel Classes="form-row">
                <TextBlock Classes="label" Text="Output Folder"/>
                <TextBox x:Name="OutputFolderBox" Width="300" IsReadOnly="True"/>
              </StackPanel>
              <StackPanel Classes="form-row">
                <TextBlock Classes="label" Text="Compression"/>
                <ComboBox x:Name="CompressionBox" Width="160"
                          SelectedIndex="0">
                  <ComboBoxItem Content="None"/>
                  <ComboBoxItem Content="LZ4"/>
                  <ComboBoxItem Content="LZMA"/>
                </ComboBox>
              </StackPanel>
            </StackPanel>
          </Border>
        </Expander>

      </StackPanel>
    </ScrollViewer>

    <!-- ─── Bottom bar ─── -->
    <StackPanel Grid.Row="2" Spacing="6">
      <!-- Progress -->
      <ProgressBar x:Name="BuildProgress" Classes="build-progress"
                   Minimum="0" Maximum="100" Value="0"
                   IsVisible="False"/>
      <TextBlock x:Name="StatusText" Classes="status" Text="Ready"/>

      <!-- Buttons -->
      <StackPanel Orientation="Horizontal" Spacing="8"
                  HorizontalAlignment="Right" Margin="0,6,0,0">
        <Button x:Name="BtnBuild"       Classes="primary"   Content="Build"/>
        <Button x:Name="BtnBuildAndRun" Classes="primary"   Content="Build &amp; Run"/>
        <Button x:Name="BtnCancel"      Classes="secondary" Content="Close"/>
      </StackPanel>
    </StackPanel>

  </Grid>
</Window>
