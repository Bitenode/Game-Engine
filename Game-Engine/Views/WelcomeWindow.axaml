<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Game_Engine.Views.WelcomeWindow"
        Title="Project hub"
        Width="540"
        Height="460"
        MinHeight="400"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <DockPanel Margin="20" LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom" Spacing="10">
      <CheckBox x:Name="ChkIncludeStandardAssets"
                Content="Include standard assets in new projects" />
      <CheckBox x:Name="ChkShowWelcomeOnStartup"
                Content="Show this hub when the editor starts" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="BtnCancel" Content="Cancel" MinWidth="88" IsCancel="True" />
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="16">
      <TextBlock Text="Game Engine"
                 FontSize="22"
                 FontWeight="SemiBold" />
      <TextBlock Text="Create a new project, open an existing one, or pick a recent project below."
                 TextWrapping="Wrap"
                 Opacity="0.85" />

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="BtnCreate" Content="Create project…" MinWidth="140" />
        <Button x:Name="BtnOpen" Content="Open project…" MinWidth="140" />
      </StackPanel>

      <TextBlock Text="Recent projects" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ListBox x:Name="RecentsList"
               MinHeight="160"
               MaxHeight="220" />
      <Button x:Name="BtnOpenRecent"
              Content="Open selected"
              HorizontalAlignment="Left"
              MinWidth="120"
              IsEnabled="False" />
    </StackPanel>
  </DockPanel>
</Window>
