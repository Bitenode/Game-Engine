<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Game_Engine.Views.WelcomeWindow"
        Title="Project hub"
        Width="560"
        Height="480"
        MinHeight="420"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
    <TextBlock Grid.Row="0"
               Text="Game Engine"
               FontSize="22"
               FontWeight="SemiBold"
               Margin="0,0,0,8" />

    <TextBlock Grid.Row="1"
               Text="Create a new project, open an existing one, or pick a recent project below."
               TextWrapping="Wrap"
               Opacity="0.85"
               Margin="0,0,0,16" />

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Spacing="10"
                Margin="0,0,0,16">
      <Button x:Name="BtnCreate" Content="Create project…" MinWidth="140" />
      <Button x:Name="BtnOpen" Content="Open project…" MinWidth="140" />
    </StackPanel>

    <TextBlock Grid.Row="3"
               Text="Recent projects"
               FontWeight="SemiBold"
               Margin="0,0,0,6" />

    <ListBox Grid.Row="4"
             x:Name="RecentsList"
             MinHeight="120"
             Margin="0,0,0,10" />

    <Button Grid.Row="5"
            x:Name="BtnOpenRecent"
            Content="Open selected"
            HorizontalAlignment="Left"
            MinWidth="120"
            Margin="0,0,0,14"
            IsEnabled="False" />

    <Grid Grid.Row="6" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
        <CheckBox x:Name="ChkIncludeStandardAssets"
                  Content="Include standard assets in new projects" />
        <CheckBox x:Name="ChkShowWelcomeOnStartup"
                  Content="Show this hub when the editor starts" />
      </StackPanel>
      <Button Grid.Column="1"
              x:Name="BtnCancel"
              Content="Cancel"
              MinWidth="88"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Right"
              IsCancel="True" />
    </Grid>
  </Grid>
</Window>
