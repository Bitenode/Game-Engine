<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Game_Engine.Views"
        x:Class="Game_Engine.Views.ScriptEditorWindow"
        Width="1280" Height="800"
        Title="Script Editor">

	<Window.Styles>
		<Style Selector="Button.se-tool-btn">
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Button.se-tool-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
		</Style>
		<Style Selector="ToggleButton.se-tool-toggle">
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="ToggleButton.se-tool-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
		</Style>
		<Style Selector="ToggleButton.se-tool-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
		<!-- Menu -->
		<Menu Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
			<MenuItem Header="_File">
				<MenuItem x:Name="MenuFileNew" Header="_New C# Script…" Click="OnMenuNewScript" />
				<Separator/>
				<MenuItem Header="_Save" Click="OnMenuSaveClick" />
				<MenuItem Header="Save _As…" Click="OnMenuSaveAsClick" />
				<MenuItem Header="_Reload" Click="OnMenuReloadClick" />
				<Separator/>
				<MenuItem Header="Close _Tab" Click="OnMenuCloseTabClick" />
				<MenuItem Header="Recent _Scripts" x:Name="MenuFileRecentRoot" />
				<Separator/>
				<MenuItem Header="E_xit" Click="OnMenuExitClick" />
			</MenuItem>
			<MenuItem Header="_Edit">
				<MenuItem Header="_Undo" Click="OnMenuUndoClick" />
				<MenuItem Header="_Redo" Click="OnMenuRedoClick" />
				<Separator/>
				<MenuItem Header="Cu_t" Click="OnMenuCutClick" />
				<MenuItem Header="_Copy" Click="OnMenuCopyClick" />
				<MenuItem Header="_Paste" Click="OnMenuPasteClick" />
				<MenuItem Header="Select _All" Click="OnMenuSelectAllClick" />
				<Separator/>
				<MenuItem Header="_Find…" Click="OnMenuFindClick" />
				<MenuItem Header="_Replace…" Click="OnMenuReplaceClick" />
				<MenuItem Header="_Go to Line…" Click="OnMenuGoToLineClick" />
				<Separator/>
				<MenuItem Header="_Format Document" Click="OnMenuFormatClick" />
			</MenuItem>
			<MenuItem Header="_View">
				<MenuItem Header="_Minimap" x:Name="MenuViewMinimap" Click="OnMenuViewMinimapClick" />
				<MenuItem Header="_Line Numbers" x:Name="MenuViewLineNumbers" Click="OnMenuViewLineNumbersClick" />
				<MenuItem Header="_Word Wrap" x:Name="MenuViewWordWrap" Click="OnMenuViewWordWrapClick" />
			</MenuItem>
			<MenuItem Header="_Build">
				<MenuItem Header="Build _All" Click="OnMenuBuildAllClick" />
			</MenuItem>
		</Menu>

		<!-- Toolbar -->
		<Border Grid.Row="1"
				Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
				BorderThickness="0,0,0,1"
				BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
				Padding="6,4">
			<StackPanel Orientation="Horizontal" Spacing="4">
				<Button x:Name="BtnNewScript" Classes="se-tool-btn" ToolTip.Tip="New C# Script (Ctrl+N)">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="&#x2795;" FontSize="12" VerticalAlignment="Center"/>
						<TextBlock Text="New" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="2,3"/>
				<Button x:Name="BtnSave" Classes="se-tool-btn" ToolTip.Tip="Save (Ctrl+S)">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="&#x1F4BE;" FontSize="12" VerticalAlignment="Center"/>
						<TextBlock Text="Save" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button x:Name="BtnSaveAs" Classes="se-tool-btn" ToolTip.Tip="Save As">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="&#x1F4C4;" FontSize="12" VerticalAlignment="Center"/>
						<TextBlock Text="Save As" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="2,3"/>
				<Button x:Name="BtnReload" Classes="se-tool-btn" ToolTip.Tip="Reload from disk">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="&#x21BB;" FontSize="13" VerticalAlignment="Center"/>
						<TextBlock Text="Reload" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button x:Name="BtnFormat" Classes="se-tool-btn" ToolTip.Tip="Format document">
					<TextBlock Text="Format" VerticalAlignment="Center"/>
				</Button>
				<Button x:Name="BtnZoomOut" Classes="se-tool-btn" ToolTip.Tip="Smaller code font (Ctrl+− or Ctrl+wheel)">
					<TextBlock Text="A−" VerticalAlignment="Center" FontSize="11"/>
				</Button>
				<Button x:Name="BtnZoomIn" Classes="se-tool-btn" ToolTip.Tip="Larger code font (Ctrl++ or Ctrl+wheel)">
					<TextBlock Text="A+" VerticalAlignment="Center" FontSize="11"/>
				</Button>
				<Button x:Name="BtnBuild" Classes="se-tool-btn" ToolTip.Tip="Build All (Ctrl+Shift+B)">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="&#x25B6;" FontSize="11" VerticalAlignment="Center" Foreground="#2E9E47"/>
						<TextBlock Text="Build All" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button x:Name="BtnDefinitionFiles" Classes="se-tool-btn" ToolTip.Tip="Show definition-indexed files (Ctrl+Shift+O)">
					<TextBlock Text="Definition Files" VerticalAlignment="Center"/>
				</Button>
				<Button x:Name="BtnFindReferences" Classes="se-tool-btn" ToolTip.Tip="Find references (Shift+F12)">
					<TextBlock Text="References" VerticalAlignment="Center"/>
				</Button>
				<Button x:Name="BtnRenameSymbol" Classes="se-tool-btn" ToolTip.Tip="Rename symbol (Ctrl+Shift+R)">
					<TextBlock Text="Rename Symbol" VerticalAlignment="Center"/>
				</Button>
				<ToggleButton x:Name="BtnToggleMinimap" Classes="se-tool-toggle" IsChecked="True" ToolTip.Tip="Toggle minimap">
					<TextBlock Text="Minimap" VerticalAlignment="Center"/>
				</ToggleButton>
				<ToggleButton x:Name="BtnToggleLineNumbers" Classes="se-tool-toggle" IsChecked="True" ToolTip.Tip="Line numbers">
					<TextBlock Text="Line numbers" VerticalAlignment="Center"/>
				</ToggleButton>
				<ToggleButton x:Name="BtnToggleWordWrap" Classes="se-tool-toggle" IsChecked="False" ToolTip.Tip="Word wrap">
					<TextBlock Text="Wrap" VerticalAlignment="Center"/>
				</ToggleButton>
				<Border Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="2,3"/>
				<Button x:Name="BtnClose" Classes="se-tool-btn" ToolTip.Tip="Close editor">
					<TextBlock Text="Close" VerticalAlignment="Center"/>
				</Button>
			</StackPanel>
		</Border>

		<!-- Tab Bar -->
		<local:EditorTabBar x:Name="TabBar" Grid.Row="2"/>

		<!-- Main split: File tree (left) + editor (right) -->
		<Grid x:Name="MainSplitGrid" Grid.Row="3" ColumnDefinitions="280,6,*">
			<!-- Project Scripts Tree -->
			<Border Grid.Column="0" Margin="6,6,0,6" Padding="4"
					Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
					BorderThickness="1"
					BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
					CornerRadius="6">
				<TreeView x:Name="FileTree"/>
			</Border>

			<!-- Splitter -->
			<GridSplitter x:Name="MainSplitter" Grid.Column="1"
						  HorizontalAlignment="Stretch"
						  VerticalAlignment="Stretch"
						  Background="Transparent"
						  ShowsPreview="True"/>

			<!-- Custom Code Editor (dark syntax-highlighted canvas) -->
			<Border Grid.Column="2" Margin="0,6,6,6"
					BorderThickness="1"
					BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
					CornerRadius="6"
					ClipToBounds="True">
				<local:CodeEditorControl x:Name="CodeEditor"/>
			</Border>
		</Grid>

		<!-- Diagnostics strip (click = go to first issue; F8 / Shift+F8 = next / prev) -->
		<Border x:Name="ProblemsStripHost" Grid.Row="4"
				Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
				BorderThickness="0,1,0,0"
				BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
				Padding="8,4"
				Cursor="Hand" PointerPressed="OnProblemsStripPointerPressed"
				ToolTip.Tip="Click: jump to first error or warning. F8 / Shift+F8: next / previous diagnostic.">
			<TextBlock x:Name="StatusProblems"
					   Foreground="#D97706"
					   FontSize="11"
					   TextTrimming="CharacterEllipsis"
					   VerticalAlignment="Center"
					   IsHitTestVisible="False"/>
		</Border>

		<!-- Status Bar -->
		<Border Grid.Row="5" Background="{DynamicResource SystemControlHighlightAccentBrush}" Padding="6,3">
			<Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
				<TextBlock x:Name="Status"
						   Grid.Column="0"
						   Foreground="White"
						   FontSize="12"
						   VerticalAlignment="Center"
						   Margin="6,0"/>
				<TextBlock x:Name="StatusPos"
						   Grid.Column="1"
						   Foreground="White"
						   FontSize="12"
						   VerticalAlignment="Center"
						   Margin="10,0"/>
				<TextBlock x:Name="StatusLines"
						   Grid.Column="2"
						   Foreground="White"
						   FontSize="12"
						   VerticalAlignment="Center"
						   Margin="10,0"/>
				<TextBlock x:Name="StatusEncoding"
						   Grid.Column="3"
						   Foreground="White"
						   FontSize="12"
						   VerticalAlignment="Center"
						   Margin="10,0"
						   Text="UTF-8"/>
				<TextBlock x:Name="StatusLanguage"
						   Grid.Column="4"
						   Foreground="White"
						   FontSize="12"
						   VerticalAlignment="Center"
						   Margin="10,0,6,0"
						   Text="C#"/>
			</Grid>
		</Border>
	</Grid>
</Window>
