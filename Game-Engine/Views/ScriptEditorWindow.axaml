<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Game_Engine.Views.ScriptEditorWindow"
        Width="1100" Height="700"
        Title="Script Editor">

	<Grid RowDefinitions="Auto,*,Auto">
		<!-- Toolbar -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8">
			<Button x:Name="BtnSave"    Content="Save"/>
			<Button x:Name="BtnSaveAs"  Content="Save As…"/>
			<Button x:Name="BtnReload"  Content="Reload"/>
			<Button x:Name="BtnBuild"   Content="Build All (Ctrl+Shift+B)"/>
			<Button x:Name="BtnClose"   Content="Close"/>
		</StackPanel>

		<!-- Main split: File tree (left) + editor (right) -->
		<Grid Grid.Row="1" ColumnDefinitions="280,6,*">
			<!-- Project Scripts Tree -->
			<Border Grid.Column="0" Margin="8" Padding="6" BorderThickness="1" BorderBrush="#303030">
				<TreeView x:Name="FileTree"/>
			</Border>

			<!-- Splitter -->
			<GridSplitter Grid.Column="1"
						  HorizontalAlignment="Stretch"
						  VerticalAlignment="Stretch"
						  Background="#303030"
						  ShowsPreview="True"/>

			<!-- Editor -->
			<Border Grid.Column="2" Margin="8" Padding="0" BorderThickness="1" BorderBrush="#303030">
				<TextBox x:Name="Editor"
						 AcceptsReturn="True"
						 AcceptsTab="True"
						 FontFamily="Consolas,Menlo,Monospace"
						 ScrollViewer.HorizontalScrollBarVisibility="Auto"
						 ScrollViewer.VerticalScrollBarVisibility="Auto"
						 TextWrapping="NoWrap"/>
			</Border>
		</Grid>

		<!-- Status -->
		<TextBlock x:Name="Status"
				   Grid.Row="2"
				   Margin="8"
				   TextWrapping="Wrap"
				   Opacity="0.85"/>
	</Grid>
</Window>