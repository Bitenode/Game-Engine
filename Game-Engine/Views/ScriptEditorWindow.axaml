<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Game_Engine.Views"
        x:Class="Game_Engine.Views.ScriptEditorWindow"
        Width="1280" Height="800"
        Title="Script Editor">

	<Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
		<!-- Menu -->
		<Menu Grid.Row="0" Background="#1E1E1E">
			<MenuItem Header="_File" Foreground="#CCCCCC">
				<MenuItem x:Name="MenuFileNew" Header="_New C# Script…" Click="OnMenuNewScript" />
				<Separator/>
				<MenuItem Header="_Save" Click="OnMenuSaveClick" />
				<MenuItem Header="Save _As…" Click="OnMenuSaveAsClick" />
				<MenuItem Header="_Reload" Click="OnMenuReloadClick" />
				<Separator/>
				<MenuItem Header="Close _Tab" Click="OnMenuCloseTabClick" />
				<MenuItem Header="Recent _Scripts" x:Name="MenuFileRecentRoot" />
				<Separator/>
				<MenuItem Header="E_xit" Click="OnMenuExitClick" />
			</MenuItem>
			<MenuItem Header="_Edit" Foreground="#CCCCCC">
				<MenuItem Header="_Undo" Click="OnMenuUndoClick" />
				<MenuItem Header="_Redo" Click="OnMenuRedoClick" />
				<Separator/>
				<MenuItem Header="Cu_t" Click="OnMenuCutClick" />
				<MenuItem Header="_Copy" Click="OnMenuCopyClick" />
				<MenuItem Header="_Paste" Click="OnMenuPasteClick" />
				<MenuItem Header="Select _All" Click="OnMenuSelectAllClick" />
				<Separator/>
				<MenuItem Header="_Find…" Click="OnMenuFindClick" />
				<MenuItem Header="_Replace…" Click="OnMenuReplaceClick" />
				<MenuItem Header="_Go to Line…" Click="OnMenuGoToLineClick" />
				<Separator/>
				<MenuItem Header="_Format Document" Click="OnMenuFormatClick" />
			</MenuItem>
			<MenuItem Header="_View" Foreground="#CCCCCC">
				<MenuItem Header="_Minimap" x:Name="MenuViewMinimap" Click="OnMenuViewMinimapClick" />
				<MenuItem Header="_Line Numbers" x:Name="MenuViewLineNumbers" Click="OnMenuViewLineNumbersClick" />
				<MenuItem Header="_Word Wrap" x:Name="MenuViewWordWrap" Click="OnMenuViewWordWrapClick" />
			</MenuItem>
			<MenuItem Header="_Build" Foreground="#CCCCCC">
				<MenuItem Header="Build _All" Click="OnMenuBuildAllClick" />
			</MenuItem>
		</Menu>

		<!-- Toolbar -->
		<Border Grid.Row="1" Background="#2D2D2D" BorderThickness="0,0,0,1" BorderBrush="#3F3F3F" Padding="4,3">
			<StackPanel Orientation="Horizontal" Spacing="2">
				<Button x:Name="BtnNewScript" ToolTip.Tip="New C# Script (Ctrl+N)"
						Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="&#x2795;" FontSize="13" VerticalAlignment="Center"/>
						<TextBlock Text="New" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Border Width="1" Background="#505050" Margin="4,2"/>
				<Button x:Name="BtnSave" ToolTip.Tip="Save (Ctrl+S)"
						Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="&#x1F4BE;" FontSize="13" VerticalAlignment="Center"/>
						<TextBlock Text="Save" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button x:Name="BtnSaveAs" ToolTip.Tip="Save As"
						Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="&#x1F4C4;" FontSize="13" VerticalAlignment="Center"/>
						<TextBlock Text="Save As" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Border Width="1" Background="#505050" Margin="4,2"/>
				<Button x:Name="BtnReload" ToolTip.Tip="Reload from disk"
						Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="&#x21BB;" FontSize="14" VerticalAlignment="Center"/>
						<TextBlock Text="Reload" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button x:Name="BtnFormat" ToolTip.Tip="Format document"
						Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<TextBlock Text="Format" VerticalAlignment="Center"/>
				</Button>
				<Button x:Name="BtnZoomOut" ToolTip.Tip="Smaller code font (Ctrl+− or Ctrl+wheel)"
						Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<TextBlock Text="A−" VerticalAlignment="Center" FontSize="11"/>
				</Button>
				<Button x:Name="BtnZoomIn" ToolTip.Tip="Larger code font (Ctrl++ or Ctrl+wheel)"
						Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<TextBlock Text="A+" VerticalAlignment="Center" FontSize="11"/>
				</Button>
				<Button x:Name="BtnBuild" ToolTip.Tip="Build All (Ctrl+Shift+B)"
						Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="&#x25B6;" FontSize="12" VerticalAlignment="Center" Foreground="#6A9955"/>
						<TextBlock Text="Build All" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button x:Name="BtnDefinitionFiles" ToolTip.Tip="Show definition-indexed files (Ctrl+Shift+O)"
						Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<TextBlock Text="Definition Files" VerticalAlignment="Center"/>
				</Button>
				<Button x:Name="BtnFindReferences" ToolTip.Tip="Find references (Shift+F12)"
						Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<TextBlock Text="References" VerticalAlignment="Center"/>
				</Button>
				<Button x:Name="BtnRenameSymbol" ToolTip.Tip="Rename symbol (Ctrl+Shift+R)"
						Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<TextBlock Text="Rename Symbol" VerticalAlignment="Center"/>
				</Button>
				<ToggleButton x:Name="BtnToggleMinimap" IsChecked="True" ToolTip.Tip="Toggle minimap"
							  Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<TextBlock Text="Minimap" VerticalAlignment="Center"/>
				</ToggleButton>
				<ToggleButton x:Name="BtnToggleLineNumbers" IsChecked="True" ToolTip.Tip="Line numbers"
							  Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<TextBlock Text="Line numbers" VerticalAlignment="Center"/>
				</ToggleButton>
				<ToggleButton x:Name="BtnToggleWordWrap" IsChecked="False" ToolTip.Tip="Word wrap"
							  Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<TextBlock Text="Wrap" VerticalAlignment="Center"/>
				</ToggleButton>
				<Border Width="1" Background="#505050" Margin="4,2"/>
				<Button x:Name="BtnClose" ToolTip.Tip="Close editor"
						Padding="8,4" FontSize="12" Background="Transparent" Foreground="#CCCCCC">
					<TextBlock Text="Close" VerticalAlignment="Center"/>
				</Button>
			</StackPanel>
		</Border>

		<!-- Tab Bar -->
		<local:EditorTabBar x:Name="TabBar" Grid.Row="2"/>

		<!-- Main split: File tree (left) + editor (right) -->
		<Grid x:Name="MainSplitGrid" Grid.Row="3" ColumnDefinitions="280,6,*">
			<!-- Project Scripts Tree -->
			<Border Grid.Column="0" Margin="8" Padding="6" BorderThickness="1" BorderBrush="#303030">
				<TreeView x:Name="FileTree"/>
			</Border>

			<!-- Splitter -->
			<GridSplitter x:Name="MainSplitter" Grid.Column="1"
						  HorizontalAlignment="Stretch"
						  VerticalAlignment="Stretch"
						  Background="#303030"
						  ShowsPreview="True"/>

			<!-- Custom Code Editor -->
			<Border Grid.Column="2" Margin="4,4,4,4" BorderThickness="1" BorderBrush="#3F3F3F" CornerRadius="2">
				<local:CodeEditorControl x:Name="CodeEditor"/>
			</Border>
		</Grid>

		<!-- Diagnostics strip (click = go to first issue; F8 / Shift+F8 = next / prev) -->
		<Border x:Name="ProblemsStripHost" Grid.Row="4" Background="#1E1E1E" BorderThickness="0,1,0,0" BorderBrush="#3F3F3F" Padding="6,3"
				Cursor="Hand" PointerPressed="OnProblemsStripPointerPressed"
				ToolTip.Tip="Click: jump to first error or warning. F8 / Shift+F8: next / previous diagnostic.">
			<TextBlock x:Name="StatusProblems"
					   Foreground="#E8C468"
					   FontSize="11"
					   TextTrimming="CharacterEllipsis"
					   VerticalAlignment="Center"
					   IsHitTestVisible="False"/>
		</Border>

		<!-- Status Bar -->
		<Border Grid.Row="5" Background="#007ACC" Padding="4,2">
			<Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
				<TextBlock x:Name="Status"
						   Grid.Column="0"
						   Foreground="White"
						   FontSize="12"
						   VerticalAlignment="Center"
						   Margin="6,0"/>
				<TextBlock x:Name="StatusPos"
						   Grid.Column="1"
						   Foreground="White"
						   FontSize="12"
						   VerticalAlignment="Center"
						   Margin="10,0"/>
				<TextBlock x:Name="StatusLines"
						   Grid.Column="2"
						   Foreground="White"
						   FontSize="12"
						   VerticalAlignment="Center"
						   Margin="10,0"/>
				<TextBlock x:Name="StatusEncoding"
						   Grid.Column="3"
						   Foreground="White"
						   FontSize="12"
						   VerticalAlignment="Center"
						   Margin="10,0"
						   Text="UTF-8"/>
				<TextBlock x:Name="StatusLanguage"
						   Grid.Column="4"
						   Foreground="White"
						   FontSize="12"
						   VerticalAlignment="Center"
						   Margin="10,0,6,0"
						   Text="C#"/>
			</Grid>
		</Border>
	</Grid>
</Window>
