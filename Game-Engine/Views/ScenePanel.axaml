<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Game_Engine.Views"
             x:Class="Game_Engine.Views.ScenePanel">

	<UserControl.Styles>
		<!-- Segmented tool radio pill (no radio circle) -->
		<Style Selector="RadioButton.scene-tool-pill">
			<Setter Property="Height" Value="24"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Focusable" Value="False"/>
			<Setter Property="Template">
				<ControlTemplate>
					<Border x:Name="PART_Border"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}"
							Padding="{TemplateBinding Padding}">
						<ContentPresenter Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="RadioButton.scene-tool-pill:pointerover">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
		</Style>
		<Style Selector="RadioButton.scene-tool-pill:checked">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="RadioButton.scene-tool-pill:checked:pointerover">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Opacity" Value="0.92"/>
		</Style>

		<!-- Compact toolbar button -->
		<Style Selector="Button.scene-tool-btn">
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Focusable" Value="False"/>
		</Style>
		<Style Selector="Button.scene-tool-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
		</Style>
		<Style Selector="Button.scene-tool-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
		</Style>

		<!-- Compact toolbar toggle (AA x2) -->
		<Style Selector="ToggleButton.scene-tool-toggle">
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="8,0"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Focusable" Value="False"/>
		</Style>
		<Style Selector="ToggleButton.scene-tool-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
		</Style>
		<Style Selector="ToggleButton.scene-tool-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="ToggleButton.scene-tool-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Opacity" Value="0.9"/>
		</Style>
	</UserControl.Styles>

	<DockPanel>

		<!-- Top toolbar strip -->
		<Border DockPanel.Dock="Top"
				Padding="8,5"
				Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
				BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
				BorderThickness="0,0,0,1">
			<WrapPanel Orientation="Horizontal"
					   HorizontalAlignment="Stretch"
					   VerticalAlignment="Center">

				<!-- Segmented transform tool pills -->
				<Border CornerRadius="5"
						Padding="2"
						Margin="0,1,8,1"
						Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
						BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
						BorderThickness="1"
						VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal" Spacing="2">
						<RadioButton Classes="scene-tool-pill" GroupName="tool"
									 ToolTip.Tip="Hand / Orbit &amp; Pan (Q)"
									 IsChecked="{Binding ElementName=Scene, Path=Tool,
                                                 Converter={StaticResource EnumEq},
                                                 ConverterParameter=Hand}">
							<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
								<Path Width="12" Height="12" Stretch="Uniform"
									  Fill="{Binding $parent[RadioButton].Foreground}"
									  Data="M6,2 A1,1 0 0 1 7,3 V7 H7.5 V2 A1,1 0 0 1 9.5,2 V7 H10 V3 A1,1 0 0 1 12,3 V8.5 C12,11.5 10,13.5 7,13.5 C4.5,13.5 2.5,12 2,9.5 L1.2,7 A1,1 0 0 1 3,6.2 L4,8 V3 A1,1 0 0 1 6,2 Z"/>
								<TextBlock Text="Hand" VerticalAlignment="Center"/>
							</StackPanel>
						</RadioButton>

						<RadioButton Classes="scene-tool-pill" GroupName="tool"
									 ToolTip.Tip="Move Tool (W)"
									 IsChecked="{Binding ElementName=Scene, Path=Tool,
                                                 Converter={StaticResource EnumEq},
                                                 ConverterParameter=Move}">
							<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
								<Path Width="12" Height="12" Stretch="Uniform"
									  Fill="{Binding $parent[RadioButton].Foreground}"
									  Data="M7,0.5 L9.5,3 H8 V6 H11 V4.5 L13.5,7 L11,9.5 V8 H8 V11 H9.5 L7,13.5 L4.5,11 H6 V8 H3 V9.5 L0.5,7 L3,4.5 V6 H6 V3 H4.5 Z"/>
								<TextBlock Text="Move" VerticalAlignment="Center"/>
							</StackPanel>
						</RadioButton>

						<RadioButton Classes="scene-tool-pill" GroupName="tool"
									 ToolTip.Tip="Rotate Tool (E)"
									 IsChecked="{Binding ElementName=Scene, Path=Tool,
                                                 Converter={StaticResource EnumEq},
                                                 ConverterParameter=Rotate}">
							<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
								<Path Width="12" Height="12" Stretch="Uniform"
									  Fill="{Binding $parent[RadioButton].Foreground}"
									  Data="M7,1.5 A5.5,5.5 0 1 1 2,9.2 L3.4,8.5 A4,4 0 1 0 7,3 V5 L10,2.5 L7,0 Z"/>
								<TextBlock Text="Rotate" VerticalAlignment="Center"/>
							</StackPanel>
						</RadioButton>

						<RadioButton Classes="scene-tool-pill" GroupName="tool"
									 ToolTip.Tip="Scale Tool (R)"
									 IsChecked="{Binding ElementName=Scene, Path=Tool,
                                                 Converter={StaticResource EnumEq},
                                                 ConverterParameter=Scale}">
							<StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
								<Path Width="12" Height="12" Stretch="Uniform"
									  Fill="{Binding $parent[RadioButton].Foreground}"
									  Data="M2,2 H7 V3.5 H4.5 L10.5,9.5 V7 H12 V12 H7 V10.5 H9.5 L3.5,4.5 V7 H2 Z"/>
								<TextBlock Text="Scale" VerticalAlignment="Center"/>
							</StackPanel>
						</RadioButton>
					</StackPanel>
				</Border>

				<!-- AA x2 toggle -->
				<ToggleButton Classes="scene-tool-toggle"
							  Content="AA ×2"
							  Margin="0,1,6,1"
							  VerticalAlignment="Center"
							  ToolTip.Tip="Supersample render at 2× and downsample (smoother edges)"
							  IsChecked="{Binding ElementName=Scene, Path=Supersample2x, Mode=TwoWay}" />

				<!-- Render Debug View mode -->
				<ComboBox x:Name="DebugViewCombo"
						  Width="132"
						  Height="26"
						  MinHeight="26"
						  Padding="8,2"
						  Margin="0,1,6,1"
						  FontSize="11"
						  CornerRadius="4"
						  VerticalAlignment="Center"
						  ToolTip.Tip="Rendering debug view (Lit, Wireframe, Albedo, Normals, Roughness, Metallic, Depth, SSAO, CSM Cascades, ToneMap Compare)"
						  SelectedIndex="0" />

				<!-- View toggles dropdown -->
				<Button Classes="scene-tool-btn"
						Content="View ▾"
						Margin="0,1,10,1"
						VerticalAlignment="Center"
						ToolTip.Tip="Viewport display toggles">
					<Button.Flyout>
						<Flyout Placement="BottomEdgeAlignedLeft">
							<StackPanel Spacing="6" Margin="6,4">
								<CheckBox Content="Grid"
										  IsChecked="{Binding ElementName=Scene, Path=ShowGrid, Mode=TwoWay}" />
								<CheckBox Content="Wire"
										  IsChecked="{Binding ElementName=Scene, Path=ShowWire, Mode=TwoWay}" />
								<CheckBox Content="Gizmos"
										  IsChecked="{Binding ElementName=Scene, Path=GizmoLocal, Mode=TwoWay}" />
								<CheckBox Content="Light"
										  IsChecked="{Binding ElementName=Scene, Path=ShowLight, Mode=TwoWay}" />
								<CheckBox Content="Shadows"
										  IsChecked="{Binding ElementName=Scene, Path=ShowShadows, Mode=TwoWay}" />
								<CheckBox Content="Selection Outline"
										  IsChecked="{Binding ElementName=Scene, Path=ShowSelectionOutline, Mode=TwoWay}" />
								<CheckBox Content="Stats Overlay"
										  IsChecked="{Binding ElementName=Scene, Path=ShowStatsOverlay, Mode=TwoWay}" />
								<CheckBox Content="2D"
										  IsChecked="{Binding ElementName=Scene, Path=Is2D, Mode=TwoWay}" />
							</StackPanel>
						</Flyout>
					</Button.Flyout>
				</Button>

				<!-- Stats overlay -->
				<TextBlock Text="{Binding ElementName=Scene, Path=StatsText}"
						   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
						   FontSize="11"
						   VerticalAlignment="Center"
						   Margin="0,1,0,1"/>

			</WrapPanel>
		</Border>

		<!-- Scene viewport -->
		<Border ClipToBounds="True">
			<views:SceneView x:Name="Scene" Focusable="True"/>
		</Border>

	</DockPanel>
</UserControl>
