<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Game_Engine.Views"
             x:Class="Game_Engine.Views.ShaderEditorPanel">
	<DockPanel>
		<!-- Toolbar -->
		<Border DockPanel.Dock="Top" Background="#18FFFFFF" Padding="8,6" CornerRadius="0,0,0,0">
			<StackPanel Orientation="Horizontal" Spacing="8">
				<TextBlock Text="Name:" FontSize="13" VerticalAlignment="Center" Foreground="#AAA" />
				<TextBox x:Name="ShaderNameBox" Width="160" Text="Custom Shader" FontSize="13"
				         Background="#2A2A3E" Foreground="White" BorderBrush="#555"
				         CaretBrush="White" SelectionBrush="#5588AAFF" />
				<Border Width="1" Background="#444" Margin="4,2" />
				<Button x:Name="CompileButton" Content="Compile" Classes="tool" />
				<Button x:Name="SaveButton" Content="Save" Classes="tool" />
				<Button x:Name="LoadButton" Content="Load" Classes="tool" />
				<Border Width="1" Background="#444" Margin="4,2" />
				<Button x:Name="AddNodeButton" Content="+ Add Node" Classes="tool" />
				<ComboBox x:Name="NodeTypeCombo" Width="180" SelectedIndex="0">
					<ComboBoxItem Content="Texture Sample" />
					<ComboBoxItem Content="Color" />
					<ComboBoxItem Content="Float" />
					<ComboBoxItem Content="Math" />
					<ComboBoxItem Content="Coordinates" />
					<ComboBoxItem Content="Fresnel" />
					<ComboBoxItem Content="Noise" />
				</ComboBox>
				<Button x:Name="DeleteNodeButton" Content="Delete Node" Classes="tool" Foreground="#FF6666" />
				<TextBlock x:Name="StatusLabel" Text="" VerticalAlignment="Center" Opacity="0.7" />
			</StackPanel>
		</Border>

		<Grid ColumnDefinitions="*,280">
			<!-- Node graph canvas -->
			<Border Grid.Column="0" Background="#1A1A2E" ClipToBounds="True" CornerRadius="4" Margin="4">
				<Canvas x:Name="GraphCanvas" Background="Transparent" />
			</Border>

			<!-- Properties + Preview panel -->
			<DockPanel Grid.Column="1" Margin="4">
				<!-- Material Preview sphere at bottom -->
				<Border DockPanel.Dock="Bottom" Background="#10FFFFFF" CornerRadius="8" Margin="0,4,0,0" Padding="8">
					<StackPanel Spacing="4" HorizontalAlignment="Center">
						<TextBlock Text="Material Preview" FontSize="11" FontWeight="SemiBold"
						           Foreground="#AAA" HorizontalAlignment="Center" />
						<Border Background="#0D0D1A" CornerRadius="100" Width="220" Height="220"
						        ClipToBounds="True" HorizontalAlignment="Center">
							<Image x:Name="PreviewImage" Width="220" Height="220" Stretch="Fill" />
						</Border>
					</StackPanel>
				</Border>

				<!-- Properties -->
				<Border Background="#10FFFFFF" CornerRadius="4" Padding="8">
					<DockPanel>
						<TextBlock DockPanel.Dock="Top" Text="Node Properties" FontSize="12"
						           Margin="0,0,0,8" FontWeight="Bold" Foreground="#CCC" />
						<ScrollViewer>
							<StackPanel x:Name="PropertiesPanel" Spacing="6" />
						</ScrollViewer>
					</DockPanel>
				</Border>
			</DockPanel>
		</Grid>
	</DockPanel>
</UserControl>
