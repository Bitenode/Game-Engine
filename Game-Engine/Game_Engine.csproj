<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Avalonia.Input.Platform" />
    <PackageReference Include="AssimpNet" Version="4.1.0" />
    <!-- This is your own general AutoConstructor SG (ok to keep) -->
    <PackageReference Include="AutoConstructor" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />

    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />

    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />

    <PackageReference Include="NAudio" Version="3.0.1" />

    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Standard Assets\Code Examples\Custom Menu%27s\" />
    <Folder Include="Standard Assets\Code Examples\Inspector\" />
  </ItemGroup>

  <!--
    Mirror Standard Assets to output after build. Content/None + CopyToOutputDirectory is unreliable for paths
    that are also Compile items (.cs templates): the SDK treats them as code first, so loose files may never copy.
    This target always mirrors the full tree next to the executable for StandardAssetsInstaller.
  -->
  <Target Name="CopyStandardAssetsToOutput" AfterTargets="Build">
    <ItemGroup>
      <_StdAssetFile Include="Standard Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_StdAssetFile)" DestinationFiles="@(_StdAssetFile->'$(TargetDir)%(Identity)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish does not always pick up files added only via a post-Build Copy; mirror into the publish folder too. -->
  <Target Name="CopyStandardAssetsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_StdAssetFilePub Include="Standard Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_StdAssetFilePub)" DestinationFiles="@(_StdAssetFilePub->'$(PublishDir)%(Identity)')" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <EmbeddedResource Remove="artifacts\**\*" />
    <None Remove="artifacts\**\*" />
    <!-- Local tool/test folders under the project must not be compiled (their obj/*.cs caused CS0579 duplicate assembly attributes). -->
    <Compile Remove="tools_euler_check\**\*" />
    <!-- Template only: mirrored to output with Standard Assets; users copy into Assets/ and compile. -->
    <Compile Remove="Standard Assets\Code Examples\Custom Menu's\MinimalEditorExtensionSample.cs" />
  </ItemGroup>
</Project>
