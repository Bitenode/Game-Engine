<?xml version="1.0" encoding="utf-8"?>
<!--
  Filled by Build Settings (Xbox GDK) or edit manually before MakePkg.
  Placeholder TitleId / MSA must be replaced with Partner Center values.
-->
<Game configVersion="1">
  <Identity Name="GameEngine.EnginePlayerGdk"
            Version="1.0.0.0"
            Publisher="CN=GameEngine" />
  <ExecutableList>
    <Executable Name="Engine.Player.Gdk.exe"
                Id="Game"
                TargetDeviceFamily="PC" />
  </ExecutableList>
  <ShellVisuals DefaultDisplayName="Engine Player GDK"
                PublisherDisplayName="Game Engine"
                Square150x150Logo="Assets\StoreLogo.png"
                Square44x44Logo="Assets\StoreLogo.png"
                Description="GDK bootstrap host for Xbox Live / XAudio2 / GameInput" />
  <MSAAppId>0000000000000000</MSAAppId>
  <TitleId>FFFFFFFF</TitleId>
  <StoreId>9NXXXXXXXXXX</StoreId>
  <DesktopRegistration>
    <DependentPackageList />
  </DesktopRegistration>
</Game>
