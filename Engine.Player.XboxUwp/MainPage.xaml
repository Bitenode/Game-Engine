<Page
    x:Class="Engine.Player.XboxUwp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Engine.Player.XboxUwp"
    Background="Black"
    XYFocusKeyboardNavigation="Enabled">

  <Grid x:Name="RootGrid">
    <!-- Must fill the window; opaque black behind until the first GL swap.
         SwapChainPanel does not support Background — setting it crashes activation. -->
    <SwapChainPanel x:Name="GlPanel"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MinWidth="64"
                    MinHeight="64"/>

    <!-- Boot/error strip only — not a second "main menu". Collapsed once the game paints. -->
    <Border x:Name="HostChrome"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Stretch"
            Background="#CC000000"
            Padding="24,16"
            Visibility="Visible">
      <StackPanel>
        <TextBlock x:Name="TitleText"
                   Text="Game"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="White"/>
        <TextBlock x:Name="SubtitleText"
                   Text="Xbox Dev Mode host"
                   FontSize="13"
                   Foreground="#FF9CA3AF"
                   Margin="0,2,0,8"/>
        <TextBlock x:Name="StatusText"
                   Text="Starting…"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="#FFD1D5DB"/>
        <!-- Kept for packager/debug; not shown as a scene picker overlay. -->
        <ListView x:Name="SceneList"
                  Visibility="Collapsed"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="SceneList_ItemClick"/>
      </StackPanel>
    </Border>
  </Grid>
</Page>
