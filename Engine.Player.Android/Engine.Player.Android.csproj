<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-android</TargetFramework>
    <RootNamespace>Game_Engine</RootNamespace>
    <AssemblyName>Engine.Player</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RunAOTCompilation>false</RunAOTCompilation>
    <ApplicationId>com.gameengine.player</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);PLAYER;ANDROID</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Game-Engine\Core\**\*.cs" Exclude="..\Game-Engine\Core\UIX\**;..\Game-Engine\Core\EditorWindows\**;..\Game-Engine\Core\Extensibility\**;..\Game-Engine\Core\Editor\**" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Game-Engine\Standard Assets\Code Examples\UI\*.cs" Link="StdUI\%(Filename)%(Extension)" />
    <Compile Include="..\Engine.Player\App.axaml.cs" Link="App.axaml.cs" />
    <Compile Include="..\Engine.Player\PlayerRoot.axaml.cs" Link="PlayerRoot.axaml.cs" />
    <Compile Include="..\Engine.Player\PlayerWindow.axaml.cs" Link="PlayerWindow.axaml.cs" />
    <Compile Include="..\Engine.Player\PlayerView.cs" Link="PlayerView.cs" />
    <Compile Include="..\Engine.Player\Platforms\Android\MainActivity.cs" Link="Platforms\Android\MainActivity.cs" />
    <Compile Include="..\Engine.Player\Platforms\Android\PlayerAndroidStorage.cs" Link="Platforms\Android\PlayerAndroidStorage.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\Engine.Player\App.axaml" Link="App.axaml" />
    <AvaloniaResource Include="..\Engine.Player\PlayerRoot.axaml" Link="PlayerRoot.axaml" />
    <AvaloniaResource Include="..\Engine.Player\PlayerWindow.axaml" Link="PlayerWindow.axaml" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="Resources\**\*" Exclude="Resources\**\AboutResources.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnginePlayerZipPath)' != ''">
    <AndroidAsset Include="$(EnginePlayerZipPath)" Link="Data.zip" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNet" Version="4.1.0" />
    <PackageReference Include="AutoConstructor" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Android" Version="11.*" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.*" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
  </ItemGroup>
</Project>
